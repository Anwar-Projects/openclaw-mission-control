# OpenClaw Mission Control - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Data Directory (optional, defaults to ./data)
# DATA_DIR=./data

# Telegram Bot Configuration (optional)
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_CHAT_ID=your_chat_id_here
TELEGRAM_ALLOWED_USERNAME=your_username
# TELEGRAM_POLL_INTERVAL_MS=1500

# Dashboard URL (for Telegram links)
# DASHBOARD_URL=http://localhost:3000

# Proxmox Configuration (optional)
# PROXMOX_HOST=192.168.1.100
# PROXMOX_USER=root
# PROXMOX_SSH_KEY=~/.ssh/openclaw_infra

# Proxmox Secondary (optional)
# PROXMOX_SECONDARY_HOST=192.168.1.101

# Home Assistant Configuration (optional)
# HOME_ASSISTANT_HOST=192.168.1.50
# HOME_ASSISTANT_SSH_PORT=2222

# Proxmox Backup Server (optional)
# PBS_HOST=192.168.1.102

# Network Device (optional)
# NETWORK_DEVICE_HOST=192.168.1.1

# Logging
# LOG_LEVEL=info
# LOG_FILE=./logs/server.log
