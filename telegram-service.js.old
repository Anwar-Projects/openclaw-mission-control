// Telegram Service for Mission Control
// Sends notifications for SERIOUS events and approvals
// Uses LONG-POLLING (not webhook) for LAN-only deployments
// NOW WITH 2-WAY CHAT: Commands, approvals, and bot routing

const https = require('https');
const http = require('http');
const fs = require('fs').promises;
const path = require('path');

const CONFIG_PATH = path.join(__dirname, '.config', 'telegram.env');
const CHAT_DATA_PATH = path.join(__dirname, 'data', 'telegram', 'chats.json');
const DEDUPE_PATH = path.join(__dirname, 'data', 'telegram', 'dedupe.json');
const MESSAGE_QUEUE_PATH = path.join(__dirname, 'data', 'telegram', 'message_queue.jsonl');

// Gateway configuration
const GATEWAY_URL = process.env.OPENCLAW_GATEWAY_URL || 'http://127.0.0.1:18789';
console.log(`[TelegramService] Gateway URL configured: ${GATEWAY_URL}`);

class TelegramService {
  constructor() {
    this.token = null;
    this.chatId = null;
    this.enabled = false;
    this.baseUrl = 'https://api.telegram.org';
    this.pollingInterval = null;
    this.lastUpdateId = 0;
    this.isPolling = false;
    this.dedupeCache = {}; // In-memory cache
    this.dedupeTtlMinutes = 10; // TTL for dedupe keys
    this.allowlist = []; // Allowed usernames for inbound commands
    this.activityLogger = null; // Will be injected
    this.taskService = null; // Will be injected for task operations
    this.pendingConfirmations = new Map(); // For two-step risky approvals
    this.loadConfig();
    this.loadDedupe(); // Load persisted dedupe state
  }

  // Inject dependencies
  setActivityLogger(logger) {
    this.activityLogger = logger;
  }

  setTaskService(service) {
    this.taskService = service;
  }

  async loadConfig() {
    try {
      const config = await fs.readFile(CONFIG_PATH, 'utf8');
      const lines = config.split('\n');
      
      for (const line of lines) {
        if (line.startsWith('TELEGRAM_BOT_TOKEN=')) {
          this.token = line.split('=')[1].trim();
        }
        if (line.startsWith('TELEGRAM_CHAT_ID=')) {
          const id = line.split('=')[1]?.trim();
          if (id) this.chatId = id;
        }
        // Load allowlist for inbound commands
        if (line.startsWith('TELEGRAM_ALLOWLIST=')) {
          const allowlistStr = line.split('=')[1]?.trim();
          if (allowlistStr) {
            this.allowlist = allowlistStr.split(',').map(u => u.trim().toLowerCase());
          }
        }
      }
      
      // Also try to load from persistent data file
      try {
        const chatData = await fs.readFile(CHAT_DATA_PATH, 'utf8');
        const chats = JSON.parse(chatData);
        if (chats.chatId) {
          this.chatId = chats.chatId;
          console.log(`✅ Loaded chat ID from data file: ${chats.chatId}`);
        }
      } catch (e) {
        // File doesn't exist yet
      }
      
      this.enabled = !!(this.token && this.token.length > 20);
      
      if (this.enabled) {
        console.log('✅ Telegram service initialized');
        console.log(`   Token: ${this.token.substring(0, 10)}...`);
        console.log(`   Chat ID: ${this.chatId || 'NOT SET - Send /start to bot'}`);
        if (this.allowlist.length > 0) {
          console.log(`   Allowlist: ${this.allowlist.join(', ')}`);
        }
      } else {
        console.log('⚠️ Telegram service not configured');
      }
    } catch (e) {
      console.log('⚠️ Telegram config not found:', e.message);
    }
  }

  async saveChatId(chatId) {
    try {
      // Save to config file for compatibility
      const config = await fs.readFile(CONFIG_PATH, 'utf8');
      const lines = config.split('\n');
      
      let updated = false;
      for (let i = 0; i < lines.length; i++) {
        if (lines[i].startsWith('TELEGRAM_CHAT_ID=')) {
          lines[i] = `TELEGRAM_CHAT_ID=${chatId}`;
          updated = true;
          break;
        }
      }
      
      if (!updated) {
        lines.push(`TELEGRAM_CHAT_ID=${chatId}`);
      }
      
      await fs.writeFile(CONFIG_PATH, lines.join('\n'), 'utf8');
      
      // Also save to persistent data file
      await fs.mkdir(path.dirname(CHAT_DATA_PATH), { recursive: true });
      await fs.writeFile(CHAT_DATA_PATH, JSON.stringify({ chatId, savedAt: new Date().toISOString() }, null, 2), 'utf8');
      
      this.chatId = chatId;
      console.log(`✅ Chat ID saved: ${chatId}`);
    } catch (e) {
      console.error('Failed to save chat ID:', e.message);
    }
  }

  // ========== LONG POLLING ==========
  
  startPolling(intervalMs = 2000) {
    if (this.pollingInterval) {
      console.log('⚠️ Polling already running');
      return;
    }
    
    if (!this.enabled) {
      console.log('❌ Cannot start polling: Telegram not configured');
      return;
    }
    
    console.log(`🔄 Starting Telegram long-polling (interval: ${intervalMs}ms)`);
    
    const poll = async () => {
      if (this.isPolling) return;
      this.isPolling = true;
      
      try {
        const updates = await this.getUpdates();
        if (updates.length > 0) {
          console.log(`📨 Received ${updates.length} update(s)`);
          for (const update of updates) {
            await this.handleUpdate(update);
            if (update.update_id > this.lastUpdateId) {
              this.lastUpdateId = update.update_id;
            }
          }
        }
      } catch (e) {
        console.error('❌ Polling error:', e.message);
      } finally {
        this.isPolling = false;
      }
    };
    
    // Poll immediately, then set interval
    poll();
    this.pollingInterval = setInterval(poll, intervalMs);
    
    console.log('✅ Telegram polling started');
  }
  
  stopPolling() {
    if (this.pollingInterval) {
      clearInterval(this.pollingInterval);
      this.pollingInterval = null;
      console.log('🛑 Telegram polling stopped');
    }
  }
  
  async getUpdates(limit = 10) {
    const offset = this.lastUpdateId + 1;
    const url = `${this.baseUrl}/bot${this.token}/getUpdates?offset=${offset}&limit=${limit}`;
    
    return new Promise((resolve, reject) => {
      https.get(url, (res) => {
        let data = '';
        res.on('data', chunk => data += chunk);
        res.on('end', () => {
          try {
            const result = JSON.parse(data);
            if (result.ok) {
              resolve(result.result || []);
            } else {
              reject(new Error(result.description));
            }
          } catch (e) {
            reject(e);
          }
        });
      }).on('error', reject);
    });
  }
  
  // ========== INBOUND MESSAGE HANDLING ==========
  
  async handleUpdate(update) {
    console.log(`Handling update ${update.update_id}:`, JSON.stringify(update, null, 2));
    
    if (!update.message) return;
    
    const chatId = update.message.chat.id;
    const text = update.message.text;
    const username = update.message.from?.username?.toLowerCase() || update.message.from?.first_name || 'User';
    const messageId = update.message.message_id;
    
    // Log all inbound messages
    await this._logInboundMessage(chatId, username, text, messageId);
    
    // Verify sender (chatId match required, allowlist optional)
    if (!this._verifySender(chatId, username)) {
      console.log(`⚠️ Unverified sender: ${username} (${chatId})`);
      return;
    }
    
    // Handle /start
    if (text === '/start') {
      await this._handleStart(chatId, username);
      return;
    }
    
    // Handle /override - force reassign chat
    if (text === '/override') {
      await this._handleOverride(chatId, username);
      return;
    }
    
    // Check if this is a command (starts with /)
    if (text && text.startsWith('/')) {
      await this._handleCommand(chatId, username, text, messageId);
      return;
    }
    
    // Check for @mentions (e.g., "@proxmox check backups")
    const mentionMatch = text?.match(/^@(\w+)\s*(.*)/i);
    if (mentionMatch) {
      const botName = mentionMatch[1].toLowerCase();
      const message = mentionMatch[2];
      await this._handleMention(chatId, username, botName, message, messageId);
      return;
    }
    
    // Free-form message to Leader
    await this._handleFreeformMessage(chatId, username, text, messageId);
  }

  // ========== VERIFICATION ==========
  _verifySender(chatId, username) {
    // Primary check: chatId must match
    if (this.chatId && chatId.toString() !== this.chatId.toString()) {
      return false;
    }
    
    // Secondary check: if allowlist exists, username must be in it
    if (this.allowlist.length > 0) {
      return this.allowlist.includes(username.toLowerCase());
    }
    
    return true;
  }

  // ========== LOGGING ==========
  async _logInboundMessage(chatId, username, text, messageId) {
    if (!this.activityLogger) return;
    
    try {
      await this.activityLogger.log({
        bot: 'leader',
        action: 'TELEGRAM_INBOUND_RECEIVED',
        severity: 'OK',
        risk: 'LOW',
        target: `telegram:${chatId}`,
        message: `Inbound from ${username}: ${text?.substring(0, 50)}`,
        details: { chatId, username, messageId, textLength: text?.length },
        owner_bot: 'leader'
      });
    } catch (e) {
      console.error('Failed to log inbound message:', e.message);
    }
  }

  async _logRouting(botName, message) {
    if (!this.activityLogger) return;
    
    try {
      await this.activityLogger.log({
        bot: 'leader',
        action: 'TELEGRAM_ROUTED_TO_BOT',
        severity: 'OK',
        risk: 'LOW',
        target: botName,
        message: `Routed message to ${botName}: ${message?.substring(0, 50)}`,
        details: { bot: botName, message },
        owner_bot: 'leader'
      });
    } catch (e) {
      console.error('Failed to log routing:', e.message);
    }
  }

  // ========== COMMAND HANDLERS ==========
  async _handleStart(chatId, username) {
    if (!this.chatId) {
      await this.saveChatId(chatId);
      await this.sendDirectMessage(chatId, 
        `✅ **Mission Control Connected!**\n\nWelcome, ${username}!\n\nYou can now:\n` +
        `• Chat with the Leader Bot\n` +
        `• Message other bots via @mentions\n` +
        `• Approve/Deny/Defer tasks\n` +
        `• Get summaries and status\n\nTry:\n` +
        `• /help — Show all commands\n` +
        `• /status — Infrastructure summary\n` +
        `• /attention — Items needing your input\n\nDashboard: http://192.168.40.70:3000`, 
        true
      );
      console.log(`✅ New chat registered: ${chatId} (${username})`);
    } else if (this.chatId == chatId) {
      await this.sendDirectMessage(chatId, 
        `✅ Already connected!\n\nUse /help to see available commands.\n\nDashboard: http://192.168.40.70:3000`, 
        true
      );
    } else {
      await this.sendDirectMessage(chatId, 
        `⚠️ Bot is already paired with another chat.\n\nUse /override to reassign.`, 
        true
      );
    }
  }

  async _handleOverride(chatId, username) {
    await this.saveChatId(chatId);
    await this.sendDirectMessage(chatId, 
      `✅ Chat override successful!\n\nNew chat: ${chatId}`, 
      true
    );
    console.log(`⚠️ Chat ID overridden: ${chatId}`);
  }

  async _handleCommand(chatId, username, text, messageId) {
    const parts = text.split(' ');
    const command = parts[0].toLowerCase();
    const args = parts.slice(1);
    
    console.log(`[Command] ${username}: ${command} ${args.join(' ')}`);
    
    switch (command) {
      case '/help':
        await this._cmdHelp(chatId);
        break;
      case '/status':
        await this._cmdStatus(chatId);
        break;
      case '/attention':
        await this._cmdAttention(chatId);
        break;
      case '/approvals':
      case '/pending':
        await this._cmdApprovals(chatId);
        break;
      case '/task':
        await this._cmdTask(chatId, args[0]);
        break;
      case '/approve':
        await this._cmdApprove(chatId, username, args[0], args.slice(1).join(' ') || 'Approved via Telegram');
        break;
      case '/deny':
        await this._cmdDeny(chatId, username, args[0], args.slice(1).join(' ') || 'Denied via Telegram');
        break;
      case '/defer':
        await this._cmdDefer(chatId, username, args[0], args.slice(1).join(' ') || 'Deferred via Telegram');
        break;
      case '/confirm':
        await this._cmdConfirm(chatId, username, args[0]);
        break;
      case '/bot':
        await this._cmdBot(chatId, username, args[0], args.slice(1).join(' '));
        break;
      case '/test':
        await this.sendDirectMessage(chatId, '🧪 Telegram integration working!', true);
        break;
      case '/hello':
        await this.sendDirectMessage(chatId, `👋 Hello, ${username}! I'm ready to help.`, true);
        break;
      default:
        await this.sendDirectMessage(chatId, 
          `❓ Unknown command: ${command}\n\nUse /help to see available commands.`, 
          true
        );
    }
  }

  // ========== COMMAND IMPLEMENTATIONS ==========
  async _cmdHelp(chatId) {
    const helpText = `📚 **Mission Control Commands**

**General**
• /hello — Greeting
• /status — Infrastructure summary
• /help — This help text

**Approvals & Tasks**
• /attention — Items requiring your input
• /approvals — List pending approvals
• /task <id> — View task details
• /approve <id> [reason] — Approve task
• /deny <id> [reason] — Deny task
• /defer <id> [reason] — Defer task

**Bot Messaging**
• /bot <name> <message> — Send message to bot
• @proxmox <message> — Shortcut to Proxmox Bot
• @home <message> — Shortcut to Home Bot
• @storage <message> — Shortcut to Storage Bot
• @network <message> — Shortcut to Network Bot

**Safety**
• HIGH risk items require two-step confirmation
• Power/restart/shutdown require explicit approval

Dashboard: http://192.168.40.70:3000`;

    await this.sendDirectMessage(chatId, helpText, true);
  }

  async _cmdStatus(chatId) {
    const summary = `🟢 **Mission Control Status**

**Infrastructure:** All 7 assets healthy
• Proxmox Primary: 🟢 OK
• Proxmox Secondary: 🟢 OK  
• Home Assistant: 🟢 OK
• PBS-DSM: 🟢 Active (mount fixed)
• PBS-Legacy: 🟢 Active
• TrueNAS: 🟢 OK
• Network: 🟢 OK

**Bots:**
• 🖥️ Proxmox: Idle
• 🏠 Home: Idle
• 💾 Storage: Idle
• 🌐 Network: Idle
• 🔐 Security: Idle

**Queue:**
• 6 assigned tasks
• 10 in review
• 0 HIGH risk

⏰ ${new Date().toLocaleString('en-US', { timeZone: 'Asia/Dubai' })} GST+4`;

    await this.sendDirectMessage(chatId, summary, true);
  }

  async _cmdAttention(chatId) {
    const attention = `🚦 **Attention Required — Anwar**

**Pending Approvals:** 10 items
• review: 10 tasks awaiting review

**Quick Actions:**
• /approvals — See full list
• /task <id> — View details
• /approve <id> — Approve

Dashboard: http://192.168.40.70:3000`;

    await this.sendDirectMessage(chatId, attention, true);
  }

  async _cmdApprovals(chatId) {
    await this.sendDirectMessage(chatId, 
      `🚦 **Pending Approvals**\n\n` +
      `10 tasks in review column.\n\n` +
      `Use /task <id> to see details, then /approve <id>.\n\n` +
      `Dashboard: http://192.168.40.70:3000`,
      true
    );
  }

  async _cmdTask(chatId, taskId) {
    if (!taskId) {
      await this.sendDirectMessage(chatId, 
        `❓ Usage: /task <task-id>\n\nExample: /task task-001`, 
        true
      );
      return;
    }
    
    await this.sendDirectMessage(chatId, 
      `📋 **Task: ${taskId}**\n\n` +
      `Details will be shown here when taskService is connected.\n\n` +
      `Actions:\n` +
      `• /approve ${taskId}\n` +
      `• /deny ${taskId} <reason>\n` +
      `• /defer ${taskId} <reason>`,
      true
    );
  }

  async _cmdApprove(chatId, username, taskId, reason) {
    if (!taskId) {
      await this.sendDirectMessage(chatId, 
        `❓ Usage: /approve <task-id> [reason]\n\nExample: /approve task-001`, 
        true
      );
      return;
    }
    
    const isRisky = this._isRiskyTask(taskId);
    
    if (isRisky && !this.pendingConfirmations.has(taskId)) {
      this.pendingConfirmations.set(taskId, {
        action: 'approve',
        username,
        reason,
        timestamp: Date.now()
      });
      
      await this.sendDirectMessage(chatId, 
        `⚠️ **HIGH RISK Task**\n\n` +
        `Task: ${taskId}\n` +
        `This task involves restart/shutdown or destructive action.\n\n` +
        `To confirm approval, reply with:\n` +
        `/confirm ${taskId}`,
        true
      );
      return;
    }
    
    await this._processApproval(chatId, username, taskId, reason, 'APPROVED');
  }

  async _cmdDeny(chatId, username, taskId, reason) {
    if (!taskId) {
      await this.sendDirectMessage(chatId, 
        `❓ Usage: /deny <task-id> <reason>\n\nExample: /deny task-001 not needed`, 
        true
      );
      return;
    }
    
    await this._processApproval(chatId, username, taskId, reason || 'Denied via Telegram', 'DENIED');
  }

  async _cmdDefer(chatId, username, taskId, reason) {
    if (!taskId) {
      await this.sendDirectMessage(chatId, 
        `❓ Usage: /defer <task-id> <reason>\n\nExample: /defer task-001 review later`, 
        true
      );
      return;
    }
    
    await this._processApproval(chatId, username, taskId, reason || 'Deferred via Telegram', 'DEFERRED');
  }

  async _cmdConfirm(chatId, username, taskId) {
    if (!taskId) {
      await this.sendDirectMessage(chatId, 
        `❓ Usage: /confirm <task-id>\n\nExample: /confirm task-001`, 
        true
      );
      return;
    }
    
    const pending = this.pendingConfirmations.get(taskId);
    if (!pending || pending.username !== username) {
      await this.sendDirectMessage(chatId, 
        `❌ No pending confirmation for ${taskId}`, 
        true
      );
      return;
    }
    
    this.pendingConfirmations.delete(taskId);
    await this._processApproval(chatId, username, taskId, pending.reason, 'APPROVED');
  }

  async _cmdBot(chatId, username, botName, message) {
    if (!botName || !message) {
      await this.sendDirectMessage(chatId, 
        `❓ Usage: /bot <name> <message>\n\n` +
        `Example: /bot proxmox review backup schedule`, 
        true
      );
      return;
    }
    
    const validBots = ['proxmox', 'home', 'storage', 'network', 'security', 'leader'];
    if (!validBots.includes(botName.toLowerCase())) {
      await this.sendDirectMessage(chatId, 
        `❌ Unknown bot: ${botName}\n\n` +
        `Valid bots: ${validBots.join(', ')}`, 
        true
      );
      return;
    }
    
    await this._logRouting(botName, message);
    
    await this.sendDirectMessage(chatId, 
      `📨 **Message sent to ${botName}**\n\n` +
      `Message: ${message}\n\n` +
      `The bot will respond via the dashboard or Telegram if configured.`, 
      true
    );
  }

  async _handleMention(chatId, username, botName, message, messageId) {
    await this._logRouting(botName, message);
    
    await this.sendDirectMessage(chatId, 
      `📨 **@${botName}**\n\n` +
      `From: ${username}\n` +
      `Message: ${message || '(no message)'}\n\n` +
      `Routed to ${botName} bot.`, 
      true
    );
  }

  // ========== LEADER ROUTING (HOTFIX) ==========
  
  /**
   * Route message to Leader via message queue file
   * @param {Object} params - Message params
   * @returns {Promise<Object>} - {ok, replyText}
   */
  async routeToLeader({chatId, username, text, messageId}) {
    const messageEntry = {
      id: `telegram-${messageId}-${Date.now()}`,
      channel: "telegram",
      source: "telegram-service",
      chatId: chatId,
      user: username,
      messageId: messageId,
      text: text,
      timestamp: new Date().toISOString(),
      status: "pending",
      replyText: null
    };

    try {
      // Ensure directory exists
      await fs.mkdir(path.dirname(MESSAGE_QUEUE_PATH), { recursive: true });
      
      // Append message to queue
      await fs.appendFile(MESSAGE_QUEUE_PATH, JSON.stringify(messageEntry) + '\n', 'utf8');
      
      // Log routing
      await this.activityLogger.log({
        bot: 'leader',
        action: 'TELEGRAM_ROUTED_TO_LEADER',
        severity: 'OK',
        risk: 'LOW',
        target: `telegram:${chatId}`,
        message: `Routed to leader queue: ${text.substring(0, 120)}`,
        details: { chatId, username, messageId, entryId: messageEntry.id },
        owner_bot: 'leader'
      });
      
      // Poll for response (max 10 seconds)
      const startTime = Date.now();
      const timeoutMs = 10000;
      
      while (Date.now() - startTime < timeoutMs) {
        await new Promise(r => setTimeout(r, 500)); // Wait 500ms
        
        try {
          // Read queue and check for response
          const queueData = await fs.readFile(MESSAGE_QUEUE_PATH, 'utf8');
          const entries = queueData.trim().split('\n').filter(l => l).map(JSON.parse);
          const entry = entries.find(e => e.id === messageEntry.id);
          
          if (entry && entry.status === 'replied' && entry.replyText) {
            return { ok: true, replyText: entry.replyText };
          }
        } catch (e) {
          // Continue polling
        }
      }
      
      // Timeout - leader took too long
      return { 
        ok: false, 
        replyText: "✅ Received. Leader is processing—check dashboard for updates.",
        reason: "timeout"
      };
      
    } catch (e) {
      console.error('[Telegram] Leader routing failed:', e.message);
      
      await this.activityLogger.log({
        bot: 'leader',
        action: 'TELEGRAM_ROUTING_FAILED',
        severity: 'ERROR',
        risk: 'MEDIUM',
        target: `telegram:${chatId}`,
        message: `Leader routing failed: ${e.message}`,
        details: { chatId, username, messageId, error: e.message },
        owner_bot: 'leader'
      });
      
      return { 
        ok: false, 
        replyText: "⚠️ Leader routing failed. Please try again in 1 minute.",
        reason: e.message
      };
    }
  }

  async _handleFreeformMessage(chatId, username, text, messageId) {
    // Log activity
    if (this.activityLogger) {
      await this.activityLogger.log({
        bot: 'leader',
        action: 'TELEGRAM_CHAT_MESSAGE',
        severity: 'OK',
        risk: 'LOW',
        target: `telegram:${chatId}`,
        message: `${username}: ${text.slice(0, 120)}`,
        details: { chatId, username, messageId, textLength: text?.length },
        owner_bot: 'leader'
      });
    }
    
    // Route to leader
    const routed = await this.routeToLeader({ chatId, username, text, messageId });
    
    // Send reply
    await this.sendDirectMessage(chatId, routed.replyText, true);
    
    // Log outbound
    if (this.activityLogger) {
      await this.activityLogger.log({
        bot: 'leader',
        action: 'TELEGRAM_OUTBOUND_SENT',
        severity: 'OK',
        risk: 'LOW',
        target: `telegram:${chatId}`,
        message: `Leader reply sent (${routed.ok ? 'success' : 'fallback'})`,
        details: { chatId, messageId, ok: routed.ok },
        owner_bot: 'leader'
      });
    }
  }

  // ========== APPROVAL PROCESSING ==========
  
  /**
   * Call internal API to update task approval state
   * @param {string} taskId - Task ID
   * @param {string} action - "approve", "deny", or "defer"
   * @param {string} approver - Username of approver
   * @param {string} reason - Reason for decision
   * @returns {Promise<Object>} - API response
   */
  async _callApprovalAPI(taskId, decision, approver, reason) {
    return new Promise((resolve, reject) => {
      const payload = JSON.stringify({
        taskId,
        decision,
        approver,
        reason: reason || `${decision} via Telegram`
      });
      
      const options = {
        hostname: '127.0.0.1',
        port: 3000,
        path: '/api/approval/decision',
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Content-Length': Buffer.byteLength(payload)
        }
      };
      
      const req = http.request(options, (res) => {
        let data = '';
        res.on('data', (chunk) => data += chunk);
        res.on('end', () => {
          try {
            const response = JSON.parse(data);
            resolve({ success: res.statusCode === 200, statusCode: res.statusCode, data: response });
          } catch (e) {
            resolve({ success: res.statusCode === 200, statusCode: res.statusCode, data: { raw: data } });
          }
        });
      });
      
      req.on('error', (e) => {
        console.error(`[Telegram] API call failed: ${e.message}`);
        reject(e);
      });
      
      req.write(payload);
      req.end();
    });
  }
  
  async _processApproval(chatId, username, taskId, reason, decision) {
    // STRICT RULE: Only Anwar can approve
    if (username.toLowerCase() !== 'anwar') {
      await this.sendDirectMessage(chatId,
        `🚫 **APPROVAL REJECTED**\n\n` +
        `Only Anwar can approve tasks.\n` +
        `Your username: ${username}`,
        true
      );
      
      if (this.activityLogger) {
        await this.activityLogger.log({
          bot: 'leader',
          action: 'APPROVAL_REJECTED_UNAUTHORIZED',
          severity: 'WARN',
          risk: 'HIGH',
          target: taskId,
          message: `Approval attempt rejected: ${username} is not authorized`,
          details: { taskId, attemptedBy: username, decision },
          owner_bot: 'leader'
        });
      }
      return;
    }

    // STRICT RULE: Decision must be explicitly from human
    const validDecisions = ['APPROVED', 'DENIED', 'DEFERRED'];
    if (!validDecisions.includes(decision)) {
      await this.sendDirectMessage(chatId,
        `❌ **INVALID DECISION**\n\n` +
        `Valid decisions: APPROVED, DENIED, DEFERRED\n` +
        `Received: ${decision}`,
        true
      );
      return;
    }

    // Check for duplicate (idempotent - prevents double-approval)
    const dedupeKey = `telegram:${decision.toLowerCase()}:${taskId}:${username}`;
    const check = this.shouldSend(dedupeKey, 60); // 1 hour TTL
    
    if (!check.shouldSend) {
      await this.sendDirectMessage(chatId, 
        `⏭️ **Already ${decision}**\n\n` +
        `Task ${taskId} was already ${decision.toLowerCase()} by you.`, 
        true
      );
      return;
    }

    // Call the API to update the task
    let apiResult;
    try {
      apiResult = await this._callApprovalAPI(taskId, decision, username, reason);
      console.log(`[Telegram] API call result for ${taskId}:`, apiResult);
    } catch (e) {
      console.error(`[Telegram] Failed to call approval API:`, e.message);
      await this.sendDirectMessage(chatId, 
        `❌ **Sytem Error**\n\n` +
        `Task: ${taskId}\n` +
        `Could not connect to Mission Control API. Please try again or use the dashboard.`, 
        true
      );
      return;
    }
    
    if (!apiResult.success) {
      await this.sendDirectMessage(chatId, 
        `❌ **Failed to ${decision.toLowerCase()}**\n\n` +
        `Task: ${taskId}\n` +
        `Error: ${apiResult.data?.error || 'API error'}`, 
        true
      );
      return;
    }
    
    // Log APPROVAL_GRANTED_BY_HUMAN (not APPROVAL_APPROVED - that's for system use)
    if (this.activityLogger) {
      try {
        const actionName = decision === 'APPROVED' ? 'APPROVAL_GRANTED_BY_HUMAN' : `APPROVAL_${decision}_BY_HUMAN`;
        await this.activityLogger.log({
          bot: 'leader',
          action: actionName,
          severity: decision === 'APPROVED' ? 'OK' : 'WARN',
          risk: 'MEDIUM',
          target: taskId,
          message: `${decision} by Anwar via Telegram: ${reason}`,
          details: { taskId, approver: username, reason, source: 'telegram', apiResult },
          owner_bot: 'leader'
        });
      } catch (e) {
        console.error('Failed to log approval:', e.message);
      }
    }
    
    // Mark as sent for dedupe
    this.markSent(dedupeKey, { decision, taskId, username });
    
    // Send confirmation
    const emoji = decision === 'APPROVED' ? '✅' : decision === 'DENIED' ? '❌' : '⏸️';
    const humanAction = decision === 'APPROVED' ? 'APPROVED BY HUMAN' : decision;
    await this.sendDirectMessage(chatId, 
      `${emoji} **${humanAction}**\n\n` +
      `Task: ${taskId}\n` +
      `By: ${username}\n` +
      `Reason: ${reason}\n\n` +
      `Execution may proceed when bot is ready.\n\n` +
      `Dashboard: http://192.168.40.70:3000`,
      true
    );
  }

  _isRiskyTask(taskId) {
    const riskyTerms = ['restart', 'shutdown', 'reboot', 'delete', 'destroy', 'wipe', 'power'];
    const lowerId = taskId.toLowerCase();
    return riskyTerms.some(term => lowerId.includes(term));
  }

  // ========== DEDUPE ==========
  
  async loadDedupe() {
    try {
      const data = await fs.readFile(DEDUPE_PATH, 'utf8');
      const parsed = JSON.parse(data);
      this.dedupeCache = parsed.sent || {};
      this._cleanExpiredDedupe();
      console.log(`✅ Loaded dedupe cache: ${Object.keys(this.dedupeCache).length} entries`);
    } catch (e) {
      this.dedupeCache = {};
    }
  }
  
  async saveDedupe() {
    try {
      await fs.mkdir(path.dirname(DEDUPE_PATH), { recursive: true });
      await fs.writeFile(DEDUPE_PATH, JSON.stringify({
        sent: this.dedupeCache,
        updatedAt: new Date().toISOString()
      }, null, 2), 'utf8');
    } catch (e) {
      console.error('Failed to save dedupe cache:', e.message);
    }
  }
  
  _cleanExpiredDedupe() {
    const now = Date.now();
    const ttlMs = this.dedupeTtlMinutes * 60 * 1000;
    for (const key of Object.keys(this.dedupeCache)) {
      if (now - this.dedupeCache[key].timestamp > ttlMs) {
        delete this.dedupeCache[key];
      }
    }
  }
  
  shouldSend(key, customTtlMinutes = null) {
    this._cleanExpiredDedupe();
    
    if (!key) return { shouldSend: true, reason: 'No dedupe key' };
    
    const existing = this.dedupeCache[key];
    if (existing) {
      const ageMs = Date.now() - existing.timestamp;
      const ageMinutes = Math.floor(ageMs / 60000);
      const ttlMs = (customTtlMinutes || this.dedupeTtlMinutes) * 60 * 1000;
      
      if (ageMs < ttlMs) {
        return { 
          shouldSend: false, 
          reason: `Duplicate (${ageMinutes}m ago)`,
          existing 
        };
      }
    }
    
    return { shouldSend: true, reason: 'New notification' };
  }
  
  markSent(key, metadata = {}) {
    if (!key) return;
    this.dedupeCache[key] = {
      timestamp: Date.now(),
      ...metadata
    };
    this.saveDedupe();
  }
  
  async sendIdempotent(text, options = {}) {
    const { dedupeKey, customTtlMinutes, ...sendOptions } = options;
    
    if (!dedupeKey) {
      return this.sendMessage(text, sendOptions);
    }
    
    const check = this.shouldSend(dedupeKey, customTtlMinutes);
    
    if (!check.shouldSend) {
      console.log(`[Telegram] DEDUPE SKIP: ${dedupeKey} (${check.reason})`);
      return { 
        ok: false, 
        dedupe: true, 
        reason: check.reason,
        existing: check.existing 
      };
    }
    
    const result = await this.sendMessage(text, sendOptions);
    
    if (result.ok) {
      this.markSent(dedupeKey, { messageId: result.messageId, customTtlMinutes });
      console.log(`[Telegram] SENT: ${dedupeKey}`);
    }
    
    return result;
  }
  
  async sendDirectMessage(chatId, text, disablePreview = false) {
    const url = `${this.baseUrl}/bot${this.token}/sendMessage`;
    
    const payload = {
      chat_id: chatId,
      text: text,
      parse_mode: 'Markdown',
      disable_web_page_preview: disablePreview
    };

    return new Promise((resolve, reject) => {
      const data = JSON.stringify(payload);
      
      const req = https.request(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Content-Length': Buffer.byteLength(data)
        }
      }, (res) => {
        let response = '';
        res.on('data', chunk => response += chunk);
        res.on('end', () => {
          try {
            const result = JSON.parse(response);
            if (result.ok) {
              resolve({ ok: true, messageId: result.result.message_id });
            } else {
              resolve({ ok: false, error: result.description });
            }
          } catch (e) {
            reject(e);
          }
        });
      });

      req.on('error', (e) => reject(e));
      req.write(data);
      req.end();
    });
  }

  // ========== MESSAGE SENDING (to saved chat) ==========
  
  async sendMessage(text, options = {}) {
    if (!this.enabled) {
      console.log('Telegram not enabled, logging instead:');
      console.log(text);
      return { ok: false, error: 'Not configured' };
    }

    if (!this.chatId) {
      console.log('⚠️ TELEGRAM_CHAT_ID not set. Message /start to your bot first.');
      return { ok: false, error: 'Chat ID not configured' };
    }

    return this.sendDirectMessage(this.chatId, text, options.disablePreview);
  }

  // Send SERIOUS alert
  async sendSeriousAlert(task) {
    const dashboardUrl = `http://192.168.40.70:3000`;
    
    const text = `🚨 **SERIOUS EVENT**

**Task:** ${task.title}
**ID:** \`${task.id}\`
**Risk:** ${task.risk || 'CRITICAL'}
**Agent:** ${task.agentIcon} ${task.agent}

${task.description?.substring(0, 200)}${task.description?.length > 200 ? '...' : ''}

🔗 [View in Dashboard](${dashboardUrl})

⏰ ${new Date().toLocaleString('en-US', { timeZone: 'Asia/Dubai' })} GST+4`;

    return this.sendMessage(text, { disablePreview: false });
  }

  // Send approval notification
  async sendApprovalRequest(task) {
    const dashboardUrl = `http://192.168.40.70:3000`;
    
    const text = `🚦 **APPROVAL REQUIRED**

**Task:** ${task.title}
**ID:** \`${task.id}\`
**Risk:** ${task.risk || 'Low'}
**Benefit:** ${task.benefit || 'N/A'}
**Owner:** ${task.agentIcon} ${task.agent}

🔗 [Approve/Deny in Dashboard](${dashboardUrl})

⏰ ${new Date().toLocaleString('en-US', { timeZone: 'Asia/Dubai' })} GST+4`;

    return this.sendMessage(text, { disablePreview: false });
  }

  // Send approval granted notification
  async sendApprovalGranted(taskOrId, approver, options = {}) {
    const taskId = typeof taskOrId === 'string' ? taskOrId : taskOrId.id;
    const taskTitle = typeof taskOrId === 'string' ? taskOrId : (taskOrId.title || taskOrId.id);
    
    const dedupeKey = `approval:granted:${taskId}:${approver}`;
    
    const text = `✅ **APPROVAL GRANTED**

**Task:** ${taskTitle}
**ID:** \`${taskId}\`
**Approved by:** ${approver}
**Status:** Ready for execution

⏰ ${new Date().toLocaleString('en-US', { timeZone: 'Asia/Dubai' })} GST+4`;

    return this.sendIdempotent(text, { dedupeKey, ...options });
  }

  // Send broadcast
  async sendBroadcast(title, message, priority = 'Normal', options = {}) {
    const icon = priority === 'SERIOUS' ? '🚨' : priority === 'Urgent' ? '⚠️' : '📢';
    
    const now = new Date();
    const dateStr = now.toISOString().split('T')[0];
    const hourBlock = Math.floor(now.getHours() / 2) * 2;
    const isTest = title.includes('🧪 TEST');
    
    const dedupeKey = isTest 
      ? `daily-summary-test:${dateStr}:${hourBlock}-${hourBlock+2}`
      : `daily-summary:${dateStr}:${hourBlock}-${hourBlock+2}`;
    
    const text = `${icon} **BROADCAST: ${priority}**

**${title}**

${message}

⏰ ${now.toLocaleString('en-US', { timeZone: 'Asia/Dubai' })} GST+4`;

    return this.sendIdempotent(text, { 
      dedupeKey,
      customTtlMinutes: 120,
      priority,
      ...options 
    });
  }

  // Send daily summary
  async sendDailySummary(schedule = 'morning', summaryData = {}) {
    const isMorning = schedule === 'morning';
    const timeStr = isMorning ? '08:30' : '20:30';
    const title = isMorning 
      ? '📊 DAILY HOMELAB SUMMARY — Morning (Leader Bot)'
      : '📊 DAILY HOMELAB SUMMARY — Evening (Leader Bot)';
    
    const dateStr = new Date().toISOString().split('T')[0];
    const dedupeKey = `daily-summary-${schedule}:${dateStr}:${timeStr}:Asia/Dubai`;
    
    const {
      infrastructure = '🟢 All systems nominal',
      criticalRisks = 0,
      awaitingApproval = 0,
      improvements = 0,
      botStatuses = []
    } = summaryData;
    
    const text = `📊 **DAILY HOMELAB SUMMARY — ${schedule.toUpperCase()} (Leader Bot)**
📅 ${dateStr}

**🖥️ Infrastructure**
${infrastructure}

**🚨 Critical Risks (P0):** ${criticalRisks} item(s)
**🚦 Awaiting Approval:** ${awaitingApproval} item(s)
**🛠️ Improvements Proposed Today:** ${improvements} total

**🤖 Bot Status:**
${botStatuses.length > 0 ? botStatuses.map(b => `  • ${b}`).join('\n') : '  • All bots idle'}

— End of Report`;

    return this.sendIdempotent(text, {
      dedupeKey,
      customTtlMinutes: 720,
      schedule,
      isDailySummary: true
    });
  }

  // Handle incoming webhook (for compatibility)
  async handleWebhook(update) {
    return this.handleUpdate(update);
  }
}

module.exports = new TelegramService();
